# ============================================================
# CARRYYEAR Environment Configuration
# ============================================================

# Database Configuration (PostgreSQL primary, SQLite fallback for lightweight tests)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carryyear
# DATABASE_URL=sqlite:///./carryyear.db

# Security & Authentication
# In production, generate a strong random 32+ character key, e.g.:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_secure_random_32_char_secret_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq AI Service Configuration (Optional: fallback deterministic engine is used if key is not configured)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# CORS & Server Settings
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Vector Store / RAG Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=./knowledge/faiss_index
